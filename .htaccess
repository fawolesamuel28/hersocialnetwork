# Her Social Network CIC - Apache configuration

# Custom error pages

ErrorDocument 404 /404.html

RewriteEngine On

# Map clean URLs (/admin -> admin.html)
RewriteRule ^admin/?$ admin.html [L,QSA]

# Serve extensionless .html files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# Redirect www to non-www
# RewriteCond %{HTTP_HOST} ^www\.hersocialnetworkcic\.uk [NC]
# RewriteRule ^(.*)$ https://hersocialnetworkcic.uk/$1 [R=301,L]

# Security headers

<IfModule mod_headers.c>
  # Content Security Policy
  Header set Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com data:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://static.cloudflareinsights.com; connect-src 'self' https://*.supabase.co https://cdn.jsdelivr.net https://cloudflareinsights.com; base-uri 'self'; form-action 'self';"

# Prevent clickjacking

Header always set X-Frame-Options "SAMEORIGIN"

# Prevent MIME sniffing

Header always set X-Content-Type-Options "nosniff"

# Enable HTTPS Strict Transport Security (HSTS)

Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

# Referrer policy

Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Enable compression for faster load times

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Cache static assets

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

# Contact form email configuration (contact.php)

# Replace values below with your actual cPanel email/SMTP settings

SetEnv MAIL_TO     info@hersocialnetwork.co.uk
SetEnv MAIL_FROM   noreply@hersocialnetwork.co.uk
SetEnv SMTP_HOST   hersocialnetwork.co.uk
SetEnv SMTP_PORT   465
SetEnv SMTP_USER   noreply@hersocialnetwork.co.uk
SetEnv SMTP_PASS   SMTP_PASSWORD_SET_IN_CPANEL
SetEnv SMTP_SECURE ssl
